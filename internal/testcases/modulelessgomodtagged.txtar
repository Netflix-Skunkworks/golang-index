# A go.mod with no module line, at a tagged commit. Unlike nogomod.txtar, where
# the missing go.mod lets the tag fall back to the repo URL, a go.mod without a
# module path fails outright: "go.mod is missing module path at revision v1.0.0".
# So the tag yields nothing. Repos really do this to fence a subtree off from its
# parent module; rules_go has a zero-byte tests/go.mod.
repo someorg/nomodule
head ff00112233445566778899aabbccddeeff001122 2026-06-07T08:09:10Z
tag v1.0.0 2025-01-12T00:00:00Z
-- someorg/nomodule/go.mod --
go 1.22
-- want --
