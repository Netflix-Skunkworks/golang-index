# Two majors of one module, each in its own major-version subdirectory, and no
# go.mod in client/ itself. Both tags carry the prefix "client", so only the
# tag's major version says whether client/v2/ or client/v3/ serves it. This is
# go.etcd.io/etcd's client layout.
skip resolving a subdir tag reads only <subdir>/go.mod, never <subdir>/vN/go.mod
repo someorg/etcdish
head 6666666666666666666666666666666666666666 2026-06-01T00:00:00Z
tag client/v2.305.0 2025-04-05T00:00:00Z
tag client/v3.5.0 2025-05-05T00:00:00Z
-- someorg/etcdish/client/v2/go.mod --
module go.example.com/etcdish/client/v2
-- someorg/etcdish/client/v3/go.mod --
module go.example.com/etcdish/client/v3
-- want --
someorg/etcdish go.example.com/etcdish/client/v2 v2.305.0 2025-04-05T00:00:00Z
someorg/etcdish go.example.com/etcdish/client/v3 v3.5.0 2025-05-05T00:00:00Z
