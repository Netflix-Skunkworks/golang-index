# The major-version subdirectory layout: tracing/ holds the v0/v1 module and
# tracing/v2/ holds its v2, so two majors of the same module coexist in one repo
# and each gets its own module path. The tracing/v2.0.0 tag is rejected because
# tracing/go.mod declares no /v2 suffix — only the tag under tracing/v2/ counts.
repo someorg/majors
head 4444444444444444444444444444444444444444 2026-06-01T00:00:00Z
tag v1.2.0 2025-01-05T00:00:00Z
tag tracing/v0.5.0 2025-02-05T00:00:00Z
tag tracing/v2.0.0 2025-03-05T00:00:00Z
tag tracing/v2/v2.1.0 2025-04-05T00:00:00Z
-- someorg/majors/go.mod --
module go.example.com/majors
-- someorg/majors/tracing/go.mod --
module go.example.com/majors/tracing
-- someorg/majors/tracing/v2/go.mod --
module go.example.com/majors/tracing/v2
-- want --
someorg/majors go.example.com/majors v1.2.0 2025-01-05T00:00:00Z
someorg/majors go.example.com/majors/tracing v0.5.0 2025-02-05T00:00:00Z
someorg/majors go.example.com/majors/tracing/v2 v2.1.0 2025-04-05T00:00:00Z
