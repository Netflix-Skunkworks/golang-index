# The tag comes from a service's CI, not from Go. With no go.mod at the root it
# resolves against the repo URL, a version the go tool will really fetch even
# though its zip carves out client/ and leaves no Go packages. That empty root
# row is why client/ gets nothing: usable tags mean no pseudo-version pass.
repo someorg/tactick
head cccc111111111111111111111111111111111111 2026-06-01T00:00:00Z
tag v0.19.0 2025-01-11T00:00:00Z
-- someorg/tactick/client/go.mod --
module go.example.com/tactick/client
-- someorg/tactick/build.gradle --
plugins { id 'nebula.netflixoss' }
-- want --
someorg/tactick github.fake.test/someorg/tactick v0.19.0 2025-01-11T00:00:00Z
