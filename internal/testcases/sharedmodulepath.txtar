# Two repos declare the same module path at the same version, as an un-renamed
# fork or a vendored copy would. Row identity is (org_repo_name, module_path,
# version), so one repo's store must not delete the other's. Only one of them
# is ever fetchable, since the path resolves to a single repo, and recording
# both keeps the collision visible instead of letting indexing order hide it.
# The feed is narrower than the table here: it publishes the module version once,
# at whichever row was seen first.
repo someorg/shared-a
head aaaa000000000000000000000000000000000000 2026-01-01T00:00:00Z
tag v1.0.0 2025-01-02T03:04:05Z

repo someorg/shared-b
head bbbb000000000000000000000000000000000000 2026-01-01T00:00:00Z
tag v1.0.0 2025-06-07T08:09:10Z
-- someorg/shared-a/go.mod --
module go.example.com/shared
-- someorg/shared-b/go.mod --
module go.example.com/shared
-- want --
someorg/shared-a go.example.com/shared v1.0.0 2025-01-02T03:04:05Z
someorg/shared-b go.example.com/shared v1.0.0 2025-06-07T08:09:10Z
