# The pseudo-version fallback is per repo, not per module: one qualifying tag
# anywhere suppresses it for every module in the repo, so the untagged
# experimental module gets no row. That is our policy, not the module system's.
# The go tool resolves experimental at a HEAD pseudo-version.
repo someorg/tagless
head dd00112233445566778899aabbccddeeff001122 2026-04-05T06:07:08Z
tag v1.0.0 2025-05-05T00:00:00Z
tag tracing/v0.3.0 2025-06-06T00:00:00Z
-- someorg/tagless/go.mod --
module go.example.com/tagless
-- someorg/tagless/tracing/go.mod --
module go.example.com/tagless/tracing
-- someorg/tagless/experimental/go.mod --
module go.example.com/tagless/experimental
-- want --
someorg/tagless go.example.com/tagless v1.0.0 2025-05-05T00:00:00Z
someorg/tagless go.example.com/tagless/tracing v0.3.0 2025-06-06T00:00:00Z
